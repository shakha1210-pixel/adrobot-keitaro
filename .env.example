# ================= Keitaro =================
# Адрес трекера (без /admin_api/v1 — путь добавляется автоматически)
KEITARO_BASE_URL=https://tlgk.host
# API-ключ: админка Keitaro → Профиль → API ключи
KEITARO_API_KEY=
# Таймаут одного запроса к Keitaro, секунды
KEITARO_TIMEOUT=15
# Повторные попытки при 5xx / сетевых ошибках
KEITARO_RETRIES=2

# ============== Параметры кампаний ==============
# Обязательный префикс названия (по заданию: test_<фамилия>_)
CAMPAIGN_PREFIX=test_familiya_
# Ротация потоков кампании: position (по позиции) | weight (по весу)
CAMPAIGN_TYPE=position
# Справочники, которые сервис ищет в Keitaro по имени
DEFAULT_DOMAIN=in.posdk.xyz
DEFAULT_GROUP=FORTESTS
DEFAULT_SOURCE=FORTESTS
# Куда редиректит первый поток (гео → ...)
REDIRECT_URL=https://google.com

# ============== Статистика (report/build) ==============
REPORT_INTERVAL=7_days_ago
REPORT_TIMEZONE=UTC

# ============== База данных ==============
# SQLite по умолчанию; PostgreSQL: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./adrobot.db
# Кэш списка офферов для автокомплита, секунды
OFFERS_CACHE_TTL=30

# ============== Демо-режим (без реального Keitaro) ==============
# python scripts/mock_keitaro.py        — поднимает эмулятор на :8999
# KEITARO_BASE_URL=http://127.0.0.1:8999
# KEITARO_API_KEY=demo
